{
  "name": "newcastle-automotive-solutions",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newcastle-automotive-solutions-db",
      "database_id": "PASTE-YOUR-DATABASE-ID-HERE"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "newcastle-automotive-solutions-photos" }
  ],
  "vars": {
    "XERO_WORKER_URL": "https://nas-xero-connector.nas-newcastle.workers.dev"
  }
}
